# ============================================================================
# ppanel-server 配置模板
# 参考 backend/internal/config/config.go 结构；顶层键大写。
# 使用说明：
#   1) 替换所有 <REPLACE: ...> 占位符；
#   2) 将完整内容放入 k3s Secret（deploy/k3s/02-ppanel-secret.yaml 的 data.ppanel.yaml），
#      再挂载到容器的 /app/etc/ppanel.yaml。
#
# CORS 白名单不在此文件中配置：合法来源（多个前端域名）写在独立的
#   ppanel-cors ConfigMap（deploy/k3s-ppanel2/02-ppanel-cors-configmap.yaml），
#   挂载到 /app/etc/cors.yaml，后端启动读取并支持热重载。
# ============================================================================

Host: 0.0.0.0
Port: 8080
Model: prod
Debug: false
AppLocation: Asia/Shanghai

JwtAuth:
  AccessSecret: "<REPLACE: openssl rand -hex 32>"
  AccessExpire: 604800

Database:
  Driver: postgres
  # 集群内 CNPG 读写端点（-rw 后缀）
  Addr: my-postgres-cluster-rw.cnpg-system.svc.cluster.local:5432
  Username: app
  Password: "<REPLACE: 集群内 CNPG app 用户密码>"
  Dbname: ppanel
  Config: sslmode=disable&TimeZone=Asia%2FShanghai

Redis:
  # 集群内 Valkey（免密）
  Host: valkey.default.svc.cluster.local:6379
  Pass: ""
  DB: 0

Subscribe:
  SubscribePath: /v1/subscribe/config
  # 订阅地址域名：不带 https://（代码自动加前缀）；支持换行多域名，取第一个
  SubscribeDomain: |
    sub.示例域名

Administrator:
  Email: admin@ppanel.dev
  Password: "<REPLACE: 管理员初始密码，生产务必修改>"
